{
  "name": "ai-playwright",
  "version": "1.0.0",
  "description": "AI Playwright Automation Framework",
  "main": "index.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "test": "playwright test",
    "smoke": "playwright test --grep @smoke",
    "regression": "playwright test --grep @regression",
    "chrome": "playwright test --project=chromium",
    "firefox": "playwright test --project=firefox",
    "edge": "playwright test --project=edge",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "ai",
    "jenkins",
    "allure"
  ],
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9"
  }
}
