pipeline {
    agent any
    
    tools {
        nodejs 'Node-20'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        CI = 'true'
        BASE_URL = credentials('base-url') // Optional: create in Jenkins credentials
        // OPENAI_API_KEY = credentials('openai-api-key') // If using AI in testcontexts
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Clean Old Reports') {
            steps {
                bat '''
                    if exist playwright-report rmdir /s /q playwright-report
                    if exist test-results rmdir /s /q test-results
                    if exist allure-results rmdir /s /q allure-results
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm ci'
            }
        }

        stage('Install Playwright') {
            steps {
                bat 'npx playwright install --with-deps chromium'
            }
        }

        stage('Verify Testcontexts') {
            steps {
                bat '''
                    echo Checking testcontexts folder...
                    if exist testcontexts dir testcontexts
                    if not exist testcontexts mkdir testcontexts
                '''
            }
        }

        stage('Run Playwright Tests') {
            steps {
                bat 'npx playwright test'
            }
        }
    }

    post {
        always {
            // JUnit for test trends
            junit allowEmptyResults: true, testResults: 'test-results/junit-results.xml'
            
            // Allure Report - Best for CI
            allure([
                includeProperties: false,
                jdk: '',
                results: [[path: 'allure-results']]
            ])

            // HTML Report
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'playwright-report',
                reportFiles: 'index.html',
                reportName: 'Playwright HTML Report'
            ])

            archiveArtifacts artifacts: 'playwright-report/**/*, test-results/**/*, allure-results/**/*', allowEmptyArchive: true
        }
    }
}
